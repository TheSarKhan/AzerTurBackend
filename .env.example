DATABASE_PASSWORD=
OPERATIONS_PASSWORD=
OPERATIONS_USER=operations
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

DEMO_PAYMENTS_ENABLED=true
EMAIL_ENABLED=false
# Persist the UTC cutover instant before activating delivery on a database with old jobs
EMAIL_DELIVERY_NOT_BEFORE=1970-01-01T00:00:00Z
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
# Resend API key is used as the SMTP password
SMTP_PASSWORD=
# Sender must belong to a verified Resend domain
SMTP_FROM=no-reply@aztrip.online

PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Base64-encoded 32-byte random server key; preserve across restarts. Never expose publicly.
ACCOUNT_LINK_KEY=
PORTAL_ORIGIN=http://127.0.0.1:4182
